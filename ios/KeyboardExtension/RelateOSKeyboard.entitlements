<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Group: shared UserDefaults + Keychain with main app -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.relateos.keyboard</string>
    </array>

    <!-- Keychain sharing group -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.relateos</string>
        <string>$(AppIdentifierPrefix)group.com.relateos.keyboard</string>
    </array>
</dict>
</plist>
